# Estimation Service — copy to .env and adjust.
# Segment modes. Format: name:mode,name:mode
# mode = exact | approximate
ES_SEGMENTS=sports:approximate,premium_users:exact,high_value_buyers:exact,casual_readers:approximate

# Fallback for segments not listed above
ES_DEFAULT_MODE=approximate

# How many days a user stays countable in a segment
ES_RETENTION_DAYS=14

ES_ADDR=:8080
# HTTP timeouts in seconds
ES_HTTP_READ_HEADER_TIMEOUT_SEC=5
ES_HTTP_READ_TIMEOUT_SEC=15
ES_HTTP_WRITE_TIMEOUT_SEC=30
ES_HTTP_IDLE_TIMEOUT_SEC=60

ES_LOG_LEVEL=info
ES_LOG_FORMAT=text

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
